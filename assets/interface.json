{
    "interface_version": 2,
    "name": "MAA-HazeWorld",
    "description": "《苍雾世界》自动化：每日演习（含每周演习商店）、指挥室、当期活动扫荡与抽卡、通行证、商城、每日任务。",
    "contact": "QQ：2017969671",
    "license": "MIT",
    "welcome": "先跑「游戏启动」，再按需选择任务；商店兑换与抽卡次数在任务选项里设置。",
    "github": "https://github.com/sleeeeeorz/MAA-HazeWorld",
    "version": "0.4.0",
    // Mirror酱为第三方分发服务，新项目默认关闭
    // 若有需要请联系 Mirror 酱 开通，直接自行开启是无法使用的
    // "mirrorchyan_rid": "MaaXXX",
    // "mirrorchyan_multiplatform": true,
    "controller": [
        {
            "name": "安卓端",
            "type": "Adb",
            "display_short_side": 720,
            "option": []
        }
    ],
    "resource": [
        {
            "name": "官服",
            "path": [
                "./resource"
            ]
        }
    ],
    "agent": {
        "child_exec": "python",
        "child_args": [
            "./agent/main.py"
        ]
    },
    "task": [
        {
            "name": "游戏初始化",
            "entry": "拉起游戏",
            "label": "游戏启动",
            "option": []
        },
        {
            "name": "每日签到",
            "entry": "签到·入口",
            "label": "每日签到",
            "description": "领取首页签到奖励、邮箱奖励和商城每日免费礼包\n三项可分别开关",
            "group": [],
            "option": [
                "签到",
                "邮箱",
                "每日领取"
            ]
        },
        {
            "name": "演习",
            "entry": "演习·入口",
            "label": "每日演习",
            "description": "每周兑换一次演习卷（商店周一刷新），再打演习；商店可在任务设置里关掉",
            "group": [],
            "option": [
                "演习商店"
            ]
        },
        {
            "name": "指挥室",
            "entry": "指挥室·入口",
            "label": "指挥室"
        },
        {
            "name": "资源",
            "entry": "新建节点30",
            "label": "资源",
            "description": "异兽清剿、核心制造、队员特训、装甲进阶\n四项里选一个执行，每组支线再选一个",
            "group": [],
            "option": [
                "资源项目"
            ]
        },
        {
            "name": "活动",
            "entry": "活动·入口",
            "label": "当期活动",
            "description": "扫荡当期活动，扫完接着抽卡\n抽卡可在任务设置里关掉",
            "group": [],
            "option": [
                "活动抽卡"
            ]
        },
        {
            "name": "通行证",
            "entry": "通行证·入口",
            "label": "通行证"
        },
        {
            "name": "任务",
            "entry": "任务·入口",
            "label": "每日任务",
            "description": "每日/每周/每月任务：三个分段各自可开关，可领取的奖励也能单独关掉",
            "option": [
                "每日任务",
                "每周任务",
                "每月任务"
            ]
        },
        {
            "name": "关闭游戏",
            "entry": "关闭游戏",
            "label": "关闭游戏"
        }
    ],
