{
    "interface_version": 2,
    "name": "MAA-HazeWorld",
    "description": "《苍雾世界》自动化：每日演习（含每周演习商店）、指挥室、当期活动扫荡与抽卡、通行证、商城、每日任务。",
    "contact": "QQ：2017969671",
    "license": "MIT",
    "welcome": "先跑「游戏启动」，再按需选择任务；商店兑换与抽卡次数在任务选项里设置。",
    "github": "https://github.com/sleeeeeorz/MAA-HazeWorld",
    "version": "0.3.0",
    // Mirror酱为第三方分发服务，新项目默认关闭
    // 若有需要请联系 Mirror 酱 开通，直接自行开启是无法使用的
    // "mirrorchyan_rid": "MaaXXX",
    // "mirrorchyan_multiplatform": true,
    "controller": [
        {
            "name": "安卓端",
            "type": "Adb",
            "display_short_side": 720,
            "option": []
        }
    ],
    "resource": [
        {
            "name": "官服",
            "path": [
                "./resource"
            ]
        }
    ],
    "agent": {
        "child_exec": "python",
        "child_args": [
            "./agent/main.py"
        ]
    },
    "task": [
        {
            "name": "游戏初始化",
            "entry": "拉起游戏",
            "label": "游戏启动",
            "option": []
        },
        {
            "name": "每日签到",
            "entry": "签到·入口",
            "label": "每日签到",
            "description": "领取首页签到奖励、邮箱奖励和商城每日免费礼包\n三项可分别开关",
            "group": [],
            "option": [
                "签到",
                "邮箱",
                "每日领取"
            ]
        },
        {
            "name": "演习",
            "entry": "演习·入口",
            "label": "每日演习",
            "description": "每周兑换一次演习卷（商店周一刷新），再打演习；商店可在任务设置里关掉",
            "group": [],
            "option": [
                "演习商店"
            ]
        },
        {
            "name": "指挥室",
            "entry": "指挥室·入口",
            "label": "指挥室"
        },
        {
            "name": "活动",
            "entry": "活动·入口",
            "label": "当期活动",
            "description": "扫荡当期活动，扫完接着抽卡\n抽卡可在任务设置里关掉",
            "group": [],
            "option": [
                "活动抽卡"
            ]
        },
        {
            "name": "通行证",
            "entry": "通行证·入口",
            "label": "通行证"
        },
        {
            "name": "任务",
            "entry": "任务·入口",
            "label": "每日任务",
            "description": "每日/每周/每月任务：三个分段各自可开关，可领取的奖励也能单独关掉",
            "option": [
                "每日任务",
                "每周任务",
                "每月任务"
            ]
        },
        {
            "name": "关闭游戏",
            "entry": "关闭游戏",
            "label": "关闭游戏"
        }
    ],
    "option": {
        "签到": {
            "type": "switch",
            "label": "首页签到",
            "description": "关掉后不点首页签到，只领商城每日礼包",
            "cases": [
                {
                    "name": "Yes",
                    "label": "开",
                    "pipeline_override": {}
                },
                {
                    "name": "No",
                    "label": "关",
                    "pipeline_override": {
                        "签到·入口": {
                            "next": [
                                "签到·收尾"
                            ]
                        }
                    }
                }
            ]
        },
        "每日领取": {
            "type": "switch",
            "label": "商城每日礼包",
            "description": "关掉后不进商城领取",
            "cases": [
                {
                    "name": "Yes",
                    "label": "开",
                    "pipeline_override": {}
                },
                {
                    "name": "No",
                    "label": "关",
                    "pipeline_override": {
                        "邮箱·收尾": {
                            "next": [
                                "结束任务（签到）"
                            ]
                        }
                    }
                }
            ]
        },
        "邮箱": {
            "type": "switch",
            "label": "邮箱领取",
            "description": "关掉后不进邮箱领取",
            "cases": [
                {
                    "name": "Yes",
                    "label": "开",
                    "pipeline_override": {}
                },
                {
                    "name": "No",
                    "label": "关",
                    "pipeline_override": {
                        "签到·收尾": {
                            "next": [
                                "邮箱·收尾"
                            ]
                        }
                    }
                }
            ]
        },
        "活动抽卡": {
            "type": "switch",
            "label": "扫荡后顺便抽卡",
            "description": "关掉就只扫荡，扫完直接结束",
            "cases": [
                {
                    "name": "Yes",
                    "label": "开",
                    "pipeline_override": {
                        "确认返回（活动）": {
                            "next": [
                                "活动-抽卡"
                            ]
                        }
                    }
                },
                {
                    "name": "No",
                    "label": "关",
                    "pipeline_override": {
                        "确认返回（活动）": {
                            "next": [
                                "结束任务（活动）"
                            ]
                        }
                    }
                }
            ]
        },
        "演习商店": {
            "type": "switch",
            "label": "兑换演习商店",
            "description": "此开关控制每周演习卷兑换，开启时进行兑换，默认开启\n若本周已进行兑换，开启后也会自动跳过",
            "cases": [
                {
                    "name": "Yes",
                    "label": "开",
                    "pipeline_override": {
                        "演习（合并）": {
                            "next": [
                                "商店检查（演习）"
                            ]
                        }
                    }
                },
                {
                    "name": "No",
                    "label": "关",
                    "pipeline_override": {
                        "演习（合并）": {
                            "next": [
                                "演习"
                            ]
                        }
                    }
                }
            ]
        },
        "每日任务": {
            "type": "switch",
            "label": "每日任务",
            "description": "关掉后不点每日任务",
            "cases": [
                {
                    "name": "Yes",
                    "label": "开",
                    "pipeline_override": {},
                    "option": [
                        "每日可领取（100 点）"
                    ]
                },
                {
                    "name": "No",
                    "label": "关",
                    "pipeline_override": {
                        "任务": {
                            "next": [
                                "跳到每周（任务）"
                            ]
                        }
                    }
                }
            ]
        },
        "每周任务": {
            "type": "switch",
            "label": "每周任务",
            "description": "关掉后不点每周任务",
            "cases": [
                {
                    "name": "Yes",
                    "label": "开",
                    "pipeline_override": {},
                    "option": [
                        "每周可领取（90 点）",
                        "每周可领取（150 点）"
                    ]
                },
                {
                    "name": "No",
                    "label": "关",
                    "pipeline_override": {
                        "跳到每周（任务）": {
                            "next": [
                                "跳到每月（任务）"
                            ]
                        },
                        "换到每周任务": {
                            "next": [
                                "跳到每月（任务）"
                            ]
                        }
                    }
                }
            ]
        },
        "每月任务": {
            "type": "switch",
            "label": "每月任务",
            "description": "关掉后不点每月任务",
            "cases": [
                {
                    "name": "Yes",
                    "label": "开",
                    "pipeline_override": {},
                    "option": [
                        "每月可领取（150 点）",
                        "每月可领取（300 点）",
                        "每月可领取（450 点）"
                    ]
                },
                {
                    "name": "No",
                    "label": "关",
                    "pipeline_override": {
                        "跳到每月（任务）": {
                            "next": [
                                "返回左上角（任务）"
                            ]
                        },
                        "换到每月任务": {
                            "next": [
                                "返回左上角（任务）"
                            ]
                        }
                    }
                }
            ]
        },
        "每日可领取（100 点）": {
            "type": "switch",
            "label": "每日 · 100 点",
            "description": "关闭后这一档不领",
            "cases": [
                {
                    "name": "Yes",
                    "label": "领",
                    "pipeline_override": {}
                },
                {
                    "name": "No",
                    "label": "不领",
                    "pipeline_override": {
                        "获得资源（每X任务）": {
                            "next": [
                                "获得资源（每X任务）_副本1"
                            ]
                        }
                    }
                }
            ]
        },
        "每周可领取（90 点）": {
            "type": "switch",
            "label": "每周 · 90 点",
            "description": "关闭后这一档不领",
            "cases": [
                {
                    "name": "Yes",
                    "label": "领",
                    "pipeline_override": {}
                },
                {
                    "name": "No",
                    "label": "不领",
                    "pipeline_override": {
                        "获得资源（每X任务）_副本2": {
                            "next": [
                                "获得资源（每X任务）_副本1_副本1"
                            ]
                        }
                    }
                }
            ]
        },
        "每周可领取（150 点）": {
            "type": "switch",
            "label": "每周 · 150 点",
            "description": "关闭后这一档不领",
            "cases": [
                {
                    "name": "Yes",
                    "label": "领",
                    "pipeline_override": {}
                },
                {
                    "name": "No",
                    "label": "不领",
                    "pipeline_override": {
                        "获得资源（每X任务）_副本1_副本1": {
                            "next": [
                                "获得资源（每X任务）_副本1_副本1_副本1"
                            ]
                        }
                    }
                }
            ]
        },
        "每月可领取（150 点）": {
            "type": "switch",
            "label": "每月 · 150 点",
            "description": "关闭后这一档不领",
            "cases": [
                {
                    "name": "Yes",
                    "label": "领",
                    "pipeline_override": {}
                },
                {
                    "name": "No",
                    "label": "不领",
                    "pipeline_override": {
                        "获得资源（每X任务）_副本3": {
                            "next": [
                                "获得资源（每X任务）_副本1_副本2"
                            ]
                        }
                    }
                }
            ]
        },
        "每月可领取（300 点）": {
            "type": "switch",
            "label": "每月 · 300 点",
            "description": "关闭后这一档不领",
            "cases": [
                {
                    "name": "Yes",
                    "label": "领",
                    "pipeline_override": {}
                },
                {
                    "name": "No",
                    "label": "不领",
                    "pipeline_override": {
                        "获得资源（每X任务）_副本1_副本2": {
                            "next": [
                                "获得资源（每X任务）_副本1_副本2_副本1"
                            ]
                        }
                    }
                }
            ]
        },
        "每月可领取（450 点）": {
            "type": "switch",
            "label": "每月 · 450 点",
            "description": "关闭后这一档不领",
            "cases": [
                {
                    "name": "Yes",
                    "label": "领",
                    "pipeline_override": {}
                },
                {
                    "name": "No",
                    "label": "不领",
                    "pipeline_override": {
                        "获得资源（每X任务）_副本1_副本2_副本1": {
                            "next": [
                                "获得资源（每X任务）_副本1_副本2_副本2"
                            ]
                        }
                    }
                }
            ]
        }
    },
    "group": []
}
