{
    // 本文件主要定义了通用 UI 的行为和显示内容
    // 可参考文档和示例添加更多您需要的功能
    // 文档：https://maafw.xyz/docs/3.3-ProjectInterfaceV2
    // 示例：https://github.com/MaaXYZ/MaaFramework/blob/main/sample/interface.json
    "interface_version": 2,
    "name": "MAA-HazeWorld",
    "description": "这是一个使用 MaaFramework 创建的新项目。",
    "contact": "QQ：2017969671",
    "license": "MIT",
    "welcome": "首次使用！欢迎使用 MAA!",
    // 填写项目地址和版本号可实现自动更新功能
    "github": "https://github.com/sleeeeeorz/MAA-HazeWorld",
    "version": "0.1.11",
    // Mirror酱为第三方分发服务，新项目默认关闭
    // 若有需要请联系 Mirror酱 开通，直接自行开启是无法使用的
    // "mirrorchyan_rid": "MaaXXX",
    // "mirrorchyan_multiplatform": true,
    "controller": [
        {
            "name": "安卓端",
            "type": "Adb",
            "display_short_side": 720,
            "option": [] // 默认缩放分辨率的短边长度
        }
    ],
    "resource": [
        {
            "name": "官服",
            "path": [
                "./resource"
            ]
        }
    ],
    // agent 子进程：child_args 是相对 interface.json 所在目录（assets/）解析的，
    // 所以要用 ../agent/main.py 才能指到项目根目录下的 agent/
    "agent": {
        "child_exec": "python",
        "child_args": [
            "../agent/main.py"
        ]
    },
    "task": [
        {
            "name": "游戏初始化",
            "entry": "游戏初始化",
            "label": "游戏启动",
            "option": []
        },
        {
            "name": "演习",
            "entry": "演习（合并）",
            "label": "每日演习",
            "description": "每周一先兑换演习卷（当周只兑一次），再打演习；商店可在任务设置里关掉",
            "group": [],
            "option": [
                "演习商店"
            ]
        },
        {
            "name": "指挥室",
            "entry": "指挥室",
            "label": "指挥室"
        },
        {
            "name": "活动",
            "entry": "活动",
            "label": "当期活动",
            "description": "扫荡当期活动，扫完接着抽卡\n抽卡可在任务设置里关掉",
            "group": [],
            "option": [
                "活动抽卡"
            ]
        },
        {
            "name": "通行证",
            "entry": "通行证",
            "label": "通行证"
        },
        {
            "name": "商城",
            "entry": "商城"
        },
        {
            "name": "任务",
            "entry": "任务",
            "label": "每日任务",
            "description": "每日/每周/每月任务：三个分段各自可开关，可领取的奖励也能单独关掉",
            "option": [
                "每日任务",
                "每周任务",
                "每月任务"
            ]
        },
        {
            "name": "关闭游戏",
            "entry": "关闭游戏",
            "label": "关闭游戏"
        }
    ],
    "option": {
        // 活动任务合并了"当期活动"和"活动抽卡"两条流水线
        // 这里决定扫荡完要不要接着抽卡：
        //   Yes -> 确认返回（活动）之后跳进 活动-抽卡 的入口
        //   No  -> 走 结束任务（活动）（StopTask），扫完就结束
        "活动抽卡": {
            "type": "switch",
            "label": "扫荡后顺便抽卡",
            "description": "关掉就只扫荡，扫完直接结束",
            "cases": [
                {
                    "name": "Yes",
                    "label": "开",
                    "pipeline_override": {
                        "确认返回（活动）": {
                            "next": [
                                "活动-抽卡"
                            ]
                        }
                    }
                },
                {
                    "name": "No",
                    "label": "关",
                    "pipeline_override": {
                        "确认返回（活动）": {
                            "next": [
                                "结束任务（活动）"
                            ]
                        }
                    }
                }
            ]
        },
        // 演习：合并了「每日演习」和「演习商店」
        // 商店按周判断：只在周一跑，且当周跑过就不再跑（状态存在 data/weekly_state.json）
        "演习商店": {
            "type": "switch",
            "label": "兑换演习商店",
            "description": "每周一自动兑换一次演习卷；当周已完成则跳过",
            "cases": [
                {
                    "name": "Yes",
                    "label": "开",
                    "pipeline_override": {
                        "演习（合并）": {
                            "next": [
                                "商店检查（演习）"
                            ]
                        }
                    }
                },
                {
                    "name": "No",
                    "label": "关",
                    "pipeline_override": {
                        "演习（合并）": {
                            "next": [
                                "演习"
                            ]
                        }
                    }
                }
            ]
        },
        // ===== 每X任务：每日 / 每周 / 每月 分段开关 =====
        // 关掉的写法：入口节点 enabled=false，父节点的 next 里会直接跳过它
        // 父节点「任务」的 next 是 [1每日任务, 2每周任务, 3每月任务]，跳过一个不影响后面的
        "每日任务": {
            "type": "switch",
            "label": "每日任务",
            "description": "关掉后不点每日任务那一栏",
            "cases": [
                {
                    "name": "Yes",
                    "label": "开",
                    "pipeline_override": {},
                    // 子选项：只有这一栏开着时才显示
                    "option": [
                        "每日可领取（100 点）"
                    ]
                },
                {
                    "name": "No",
                    "label": "关",
                    "pipeline_override": {
                        "任务": {
                            "next": [
                                "跳到每周（任务）"
                            ]
                        }
                    }
                }
            ]
        },
        "每周任务": {
            "type": "switch",
            "label": "每周任务",
            "description": "关掉后不点每周任务那一栏",
            "cases": [
                {
                    "name": "Yes",
                    "label": "开",
                    "pipeline_override": {},
                    // 子选项：每周有两档，各自独立开关
                    "option": [
                        "每周可领取（90 点）",
                        "每周可领取（150 点）"
                    ]
                },
                {
                    "name": "No",
                    "label": "关",
                    "pipeline_override": {
                        "跳到每周（任务）": {
                            "next": [
                                "跳到每月（任务）"
                            ]
                        },
                        "换到每周任务": {
                            "next": [
                                "跳到每月（任务）"
                            ]
                        }
                    }
                }
            ]
        },
        "每月任务": {
            "type": "switch",
            "label": "每月任务",
            "description": "关掉后不点每月任务那一栏",
            "cases": [
                {
                    "name": "Yes",
                    "label": "开",
                    "pipeline_override": {},
                    // 子选项：每月有三档，各自独立开关
                    "option": [
                        "每月可领取（150 点）",
                        "每月可领取（300 点）",
                        "每月可领取（450 点）"
                    ]
                },
                {
                    "name": "No",
                    "label": "关",
                    "pipeline_override": {
                        "跳到每月（任务）": {
                            "next": [
                                "返回左上角（任务）"
                            ]
                        },
                        "换到每月任务": {
                            "next": [
                                "返回左上角（任务）"
                            ]
                        }
                    }
                }
            ]
        },
        // ===== 每X任务：可领取奖励的开关（一档一个开关）=====
        // 每档的点数就是解锁需要的累计点数，点数不够时这一档识别不到，属正常。
        // 关掉的写法：把"领之前那个节点"的 next 直接接到"领之后"的节点，等于跳过这一档，
        // 后面的档位仍然会继续领。
        //
        // 每日（1 档）：100
        //   获得资源（每X任务） → 可领取-100（day） → 获得资源（每X任务）_副本1
        "每日可领取（100 点）": {
            "type": "switch",
            "label": "每日 · 100 点",
            "description": "每日任务里需要 100 点的那档奖励。关闭后跳过它，不影响后面的周/月任务。",
            "cases": [
                {
                    "name": "Yes",
                    "label": "领",
                    "pipeline_override": {}
                },
                {
                    "name": "No",
                    "label": "不领",
                    "pipeline_override": {
                        "获得资源（每X任务）": {
                            "next": [
                                "获得资源（每X任务）_副本1"
                            ]
                        }
                    }
                }
            ]
        },
        // 每周第 1 档：90 点
        //   获得资源（每X任务）_副本2 → 可领取-90（week） → 获得资源（每X任务）_副本1_副本1
        "每周可领取（90 点）": {
            "type": "switch",
            "label": "每周 · 90 点",
            "description": "每周任务里需要 90 点的那档奖励。关闭后这一档不领，150 点那档照常领。",
            "cases": [
                {
                    "name": "Yes",
                    "label": "领",
                    "pipeline_override": {}
                },
                {
                    "name": "No",
                    "label": "不领",
                    "pipeline_override": {
                        "获得资源（每X任务）_副本2": {
                            "next": [
                                "获得资源（每X任务）_副本1_副本1"
                            ]
                        }
                    }
                }
            ]
        },
        // 每周第 2 档：150 点
        //   获得资源（每X任务）_副本1_副本1 → 可领取-150（week） → 获得资源（每X任务）_副本1_副本1_副本1
        "每周可领取（150 点）": {
            "type": "switch",
            "label": "每周 · 150 点",
            "description": "每周任务里需要 150 点的那档奖励。关闭后领完 90 点档就直接去每月任务。",
            "cases": [
                {
                    "name": "Yes",
                    "label": "领",
                    "pipeline_override": {}
                },
                {
                    "name": "No",
                    "label": "不领",
                    "pipeline_override": {
                        "获得资源（每X任务）_副本1_副本1": {
                            "next": [
                                "获得资源（每X任务）_副本1_副本1_副本1"
                            ]
                        }
                    }
                }
            ]
        },
        // 每月第 1 档：150 点
        //   获得资源（每X任务）_副本3 → 可领取-150（month） → 获得资源（每X任务）_副本1_副本2
        "每月可领取（150 点）": {
            "type": "switch",
            "label": "每月 · 150 点",
            "description": "每月任务里需要 150 点的那档奖励。关闭后这一档不领，300 / 450 点两档照常领。",
            "cases": [
                {
                    "name": "Yes",
                    "label": "领",
                    "pipeline_override": {}
                },
                {
                    "name": "No",
                    "label": "不领",
                    "pipeline_override": {
                        "获得资源（每X任务）_副本3": {
                            "next": [
                                "获得资源（每X任务）_副本1_副本2"
                            ]
                        }
                    }
                }
            ]
        },
        // 每月第 2 档：300 点
        //   获得资源（每X任务）_副本1_副本2 → 可领取-300（month）_副本1 → 获得资源（每X任务）_副本1_副本2_副本1
        "每月可领取（300 点）": {
            "type": "switch",
            "label": "每月 · 300 点",
            "description": "每月任务里需要 300 点的那档奖励。关闭后跳过它，450 点那档照常领。",
            "cases": [
                {
                    "name": "Yes",
                    "label": "领",
                    "pipeline_override": {}
                },
                {
                    "name": "No",
                    "label": "不领",
                    "pipeline_override": {
                        "获得资源（每X任务）_副本1_副本2": {
                            "next": [
                                "获得资源（每X任务）_副本1_副本2_副本1"
                            ]
                        }
                    }
                }
            ]
        },
        // 每月第 3 档：450 点
        //   获得资源（每X任务）_副本1_副本2_副本1 → 可领取-450（month）_副本1 → 获得资源（每X任务）_副本1_副本2_副本2
        "每月可领取（450 点）": {
            "type": "switch",
            "label": "每月 · 450 点",
            "description": "每月任务里需要 450 点的那档奖励，是领完最后一档才回主界面的。",
            "cases": [
                {
                    "name": "Yes",
                    "label": "领",
                    "pipeline_override": {}
                },
                {
                    "name": "No",
                    "label": "不领",
                    "pipeline_override": {
                        "获得资源（每X任务）_副本1_副本2_副本1": {
                            "next": [
                                "获得资源（每X任务）_副本1_副本2_副本2"
                            ]
                        }
                    }
                }
            ]
        }
    },
    "group": []
}
